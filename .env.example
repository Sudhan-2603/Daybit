# Daybit Environment Configuration

# Server Port
PORT=4000

# MongoDB Connection String (Atlas or Local MongoDB)
DATABASE_URL=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/daybit?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret

# WhatsApp Cloud API Webhook Integration (Optional)
# Obtain credentials from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=daybit_whatsapp_verify_token
